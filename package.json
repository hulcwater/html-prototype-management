{
  "name": "html-prototype-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx dev-server.ts",
    "deploy": "wrangler pages deploy public",
    "deploy:worker": "wrangler deploy",
    "db:init": "wrangler d1 execute html-prototypes --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute html-prototypes --remote --file=./schema.sql",
    "db:init:local": "npx tsx dev-server.ts --init-only",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@types/node": "^26.0.0",
    "sql.js": "^1.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "wrangler": "^4.0.0"
  }
}
